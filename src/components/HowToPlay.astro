                <span class="text-slate-400 text-xs ml-auto text-right">(Sequel, Prequel, Spin-off)</span>
            </div>
            
            <div class="flex items-center gap-3 p-3 bg-slate-950 rounded-xl border border-white/5">
                <span class="w-3 h-3 rounded-full bg-indigo-400"></span>
                <span class="text-white text-sm font-bold w-20">Anime</span>
                <span class="text-slate-500 text-xs">↔</span>
                <span class="w-3 h-3 rounded-full bg-emerald-400"></span>
                <span class="text-white text-sm font-bold">Studio</span>
                <span class="text-slate-400 text-xs ml-auto text-right">(Main Animator)</span>
            </div>

            <div class="flex items-center gap-3 p-3 bg-slate-950 rounded-xl border border-white/5">
                <span class="w-3 h-3 rounded-full bg-indigo-400"></span>
                <span class="text-white text-sm font-bold w-20">Anime</span>
                <span class="text-slate-500 text-xs">↔</span>
                <span class="w-3 h-3 rounded-full bg-rose-400"></span>
                <span class="text-white text-sm font-bold">Character</span>
                <span class="text-slate-400 text-xs ml-auto text-right">(Main/Key Supporting Role)</span>
            </div>

            <div class="flex items-center gap-3 p-3 bg-slate-950 rounded-xl border border-white/5">
                <span class="w-3 h-3 rounded-full bg-rose-400"></span>
                <span class="text-white text-sm font-bold w-20">Character</span>
