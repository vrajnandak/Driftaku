			<p class="text-sm text-slate-400 leading-relaxed relative z-10">Use your mouse or touch controls to zoom and pan around the canvas. Every daily challenge generates a unique, pre-calculated web.</p>
		</div>

		<!-- Step 2 -->
		<div class="bg-slate-900 p-8 rounded-[2rem] border border-white/5 relative overflow-hidden group hover:border-emerald-500/30 transition-colors">
			<div class="absolute -right-6 -top-6 text-9xl font-black text-white/[0.03] group-hover:text-emerald-500/10 transition-colors pointer-events-none">2</div>
			<div class="w-12 h-12 bg-emerald-500/20 rounded-2xl flex items-center justify-center text-emerald-400 mb-6">
