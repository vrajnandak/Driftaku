---
interface Props {
	players?: string;
	avgTime?: string;
}

const { players = "0", avgTime = "0s" } = Astro.props;
---

<div class="bg-indigo-600 rounded-2xl p-6 shadow-lg shadow-indigo-500/20">
	<h3 class="font-bold text-white mb-2">Daily Stats</h3>
	<p class="text-indigo-100 text-sm">
		{players} players have attempted today's web. Average time: {avgTime}.
	</p>
	<button class="w-full mt-4 bg-white text-indigo-600 font-bold py-2 rounded-lg hover:bg-indigo-50 transition active:scale-95">
		Share Result
	</button>
</div>