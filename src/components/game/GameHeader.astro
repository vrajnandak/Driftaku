---
interface Props {
    title: string;
    startName: string;
    endName: string;
    globalAvg?: number | null; // Pass the average time in seconds if available
}

const { title, startName, endName, globalAvg } = Astro.props;

// Helper to format seconds into MM:SS.s (e.g., 42.5 -> 00:42.5)
const formatTime = (seconds?: number | null) => {
    if (!seconds || seconds <= 0) return "--:--.-"; // Placeholder for the start of the day
    const m = Math.floor(seconds / 60).toString().padStart(2, '0');
    const s = (seconds % 60).toFixed(1).padStart(4, '0');
    return `${m}:${s}`;
};
---

<header class="relative z-40 border-b border-white/10 bg-slate-950/80 backdrop-blur-md w-full shadow-md">
    <div class="p-6 border-b border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-900">
        
        <!-- LEFT: Title & Path -->
        <div class="flex-1 min-w-0">
            <h1 class="text-base md:text-xl font-black text-white uppercase tracking-tighter truncate drop-shadow-sm">
                {title}
            </h1>
            
            <div class="flex items-center gap-2 mt-1 md:mt-1.5 text-[10px] md:text-xs font-bold tracking-widest uppercase">
                <!-- Start Node -->
                <div class="flex items-center gap-1.5 min-w-0">
                    <div class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-white shadow-[0_0_8px_rgba(255,255,255,0.8)] shrink-0"></div>
                    <span class="text-slate-300 truncate max-w-[110px] sm:max-w-[150px] md:max-w-[200px]" title={startName}>
                        {startName}
                    </span>
                </div>

                <!-- Arrow -->
                <svg class="w-3 h-3 text-slate-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>

                <!-- Target Node -->
                <div class="flex items-center gap-1.5 min-w-0">
                    <div class="w-1.5 h-1.5 md:w-2 md:h-2 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.8)] shrink-0"></div>
                    <span class="text-cyan-400 truncate max-w-[110px] sm:max-w-[150px] md:max-w-[200px]" title={endName}>
                        {endName}
                    </span>
                </div>
            </div>
        </div>

        <!-- RIGHT: Stats & Controls -->
        <div class="flex items-center justify-between sm:justify-end gap-4 md:gap-6 shrink-0 border-t border-white/5 pt-3 sm:border-0 sm:pt-0 mt-1 sm:mt-0">
            
            <div class="flex flex-col sm:items-end bg-slate-900/50 sm:bg-transparent px-3 py-1.5 sm:p-0 rounded-lg border border-white/5 sm:border-0">
                <span class="text-[9px] md:text-[10px] uppercase text-slate-500 font-bold tracking-widest">Global Avg</span>
                <span class={`font-mono text-sm md:text-lg font-black ${globalAvg ? 'text-slate-300' : 'text-slate-600'}`}>
                    {formatTime(globalAvg)}
                </span>
            </div>

            <div class="w-px h-8 bg-white/10 hidden sm:block"></div>
            
            <!-- Quit Button -->
            <a 
                href="/" 
                title="Quit Game"
                class="flex items-center justify-center w-9 h-9 md:w-10 md:h-10 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-500 hover:bg-rose-500 hover:text-white transition-all active:scale-95 shrink-0"
            >
                <svg class="w-4 h-4 md:w-5 md:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                </svg>
            </a>
            
        </div>
    </div>
</header>