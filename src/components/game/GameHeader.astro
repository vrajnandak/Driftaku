---
interface Props {
    title: string;
    startName: string;
    endName: string;
}
const { title, startName, endName } = Astro.props;
---
<div class="p-6 border-b border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-4 bg-slate-900">
    <div>
        <h1 class="text-xl font-bold text-white">{title}</h1>
        <p class="text-slate-400 text-sm">
            Connect <span class="text-indigo-400 font-bold">{startName}</span> 
            to <span class="text-emerald-400 font-bold">{endName}</span>
        </p>
    </div>
    <div class="flex items-center gap-6">
        <div class="text-right">
            <p class="text-[10px] uppercase text-slate-500 font-bold tracking-widest">Global Avg</p>
            <p class="text-lg font-mono text-slate-300">00:42.5</p>
        </div>
        <a href="/" class="text-xs text-slate-500 hover:text-white transition underline underline-offset-4">Quit</a>
    </div>
</div>