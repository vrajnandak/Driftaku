---
const faqs = [
    { q: "Is Driftaku free to play?", a: "Yes, Driftaku is 100% free. We sustain the site through non-intrusive ads to keep the servers running and the database updated." },
    { q: "How often do challenges reset?", a: "The Global Daily Web resets every day at 00:00 UTC. Custom 'Vs. Friends' rooms are available 24/7." },
    { q: "Where does the data come from?", a: "Our relationship data is fetched and verified from the AniList API, ensuring up-to-date character and staff information for even the newest seasonal releases." },
    { q: "Can I play on mobile?", a: "Driftaku is built with a mobile-first philosophy. We support pinch-to-zoom and touch-drag gestures on all modern smartphones." }
];
---
<section class="max-w-4xl mx-auto px-4 py-24">
    <h2 class="text-3xl font-black text-white uppercase tracking-tighter mb-12 text-center">Frequently Asked Questions</h2>
    <div class="space-y-4">
        {faqs.map(faq => (
            <div class="bg-slate-900/50 border border-white/5 rounded-2xl p-6 hover:border-white/10 transition-colors">
                <h3 class="text-white font-bold mb-3">{faq.q}</h3>
                <p class="text-slate-400 text-sm leading-relaxed">{faq.a}</p>
            </div>
        ))}
    </div>
</section>