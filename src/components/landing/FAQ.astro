---
const faqs = [
    { 
        q: "Is Driftaku free to play?", 
        a: "Yes, Driftaku is 100% free. We sustain the site through highly optimized server caching (so you play without lag) and non-intrusive ads to keep the database updated." 
    },
    { 
        q: "How often do challenges reset?", 
        a: "The Global Daily Web resets every day at 00:00 UTC. Custom 'Vs. Friends' multiplayer browser lobbies are available 24/7." 
    },
    { 
        q: "How do I build a winning trap in 'Vs. Friends' mode?", 
        a: "In the Build Phase, use the sidebar to drag nodes onto the canvas. If you know a connection, deploy it. If you don't, select a node and click 'Suggest Connections' to see its hidden edges! Once your web is perfectly chaotic, use the Start and Target tools, manually toggle the path you want them to solve, and hit Submit. Stuck? Just use the 'Auto-Build' feature!" 
    },
    { 
        q: "Why should I manually build the graph instead of Auto-Building?", 
        a: "Strategy! By using the 'Suggest Connections' tool during the Build Phase, you are secretly studying the nodes and their edges. This gives you a massive mental advantage when it's your turn to solve your opponent's graph." 
    },
    { 
        q: "Can I play on mobile?", 
        a: "Absolutely. Driftaku is built with a mobile-first philosophy. We support pinch-to-zoom, touch-drag gestures, full-screen modes, and dynamic camera centering on all modern smartphones." 
    }
];

// NEW: Dynamically map your array to Google's FAQ Schema format
const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(faq => ({
        "@type": "Question",
        "name": faq.q,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": faq.a
        }
    }))
};
---

<!-- NEW: Inject the JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>

<section class="max-w-4xl mx-auto px-4 py-12 border-t border-white/5">
    <h2 class="text-3xl font-black text-white uppercase tracking-tighter mb-12 text-center">Frequently Asked Questions</h2>
    <div class="space-y-4">
        {faqs.map(faq => (
            <div class="bg-slate-900/50 border border-white/5 rounded-2xl p-6 hover:border-white/10 transition-colors">
                <h3 class="text-white font-bold mb-3">{faq.q}</h3>
                <p class="text-slate-400 text-sm leading-relaxed">{faq.a}</p>
            </div>
        ))}
    </div>
</section>