---
---
<section class="relative bg-gradient-to-b from-slate-900 to-slate-950 rounded-[2.5rem] border border-indigo-500/20 shadow-2xl overflow-hidden p-8 md:p-16">
    <!-- Background Accents -->
    <div class="absolute top-0 right-0 w-64 h-64 bg-indigo-600/10 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-fuchsia-600/10 blur-[100px] rounded-full pointer-events-none"></div>

    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        
        <!-- LEFT COLUMN: Roadmap -->
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-fuchsia-500/10 border border-fuchsia-500/20 text-fuchsia-400 text-[10px] font-bold uppercase tracking-widest mb-6">
                <span class="w-2 h-2 rounded-full bg-fuchsia-500 animate-pulse"></span>
                Active Development
            </div>
            
            <h2 class="text-3xl md:text-4xl font-black text-white uppercase tracking-tighter mb-8">What's Next?</h2>
            
            <div class="space-y-6 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px md:before:mx-auto md:before:translate-x-0 before:h-full before:w-0.5 before:bg-gradient-to-b before:from-indigo-500 before:via-fuchsia-500 before:to-transparent md:before:hidden">
                
                <!-- Feature 1 -->
                <div class="relative flex items-center gap-6">
                    <div class="w-10 h-10 rounded-full bg-slate-950 border-2 border-indigo-500 flex items-center justify-center text-indigo-400 shrink-0 z-10 shadow-[0_0_10px_rgba(99,102,241,0.3)]">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <div>
                        <h4 class="text-white font-bold text-lg mb-1">Global Seasons</h4>
                        <p class="text-xs text-slate-400 leading-relaxed">Monthly leaderboard resets with unique flair badges for the top 10 fastest drifters.</p>
                    </div>
                </div>

                <!-- Feature 2 -->
                <div class="relative flex items-center gap-6">
                    <div class="w-10 h-10 rounded-full bg-slate-950 border-2 border-fuchsia-500 flex items-center justify-center text-fuchsia-400 shrink-0 z-10 shadow-[0_0_10px_rgba(217,70,239,0.3)]">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    </div>
                    <div>
                        <h4 class="text-white font-bold text-lg mb-1">Manga & Authors Expansion</h4>
                        <p class="text-xs text-slate-400 leading-relaxed">Introducing Mangakas and light novel properties into the database to massively expand the web.</p>
                    </div>
                </div>

                <!-- Feature 3 -->
                <div class="relative flex items-center gap-6">
                    <div class="w-10 h-10 rounded-full bg-slate-950 border-2 border-slate-700 flex items-center justify-center text-slate-500 shrink-0 z-10">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    </div>
                    <div>
                        <h4 class="text-slate-300 font-bold text-lg mb-1">Ranked Matchmaking</h4>
                        <p class="text-xs text-slate-500 leading-relaxed">Skill-based automated matchmaking for 1v1 puzzle battles against random opponents.</p>
                    </div>
                </div>

            </div>
        </div>

        <!-- RIGHT COLUMN: Solo Dev Support Message -->
        <div class="bg-slate-950/50 border border-indigo-500/30 p-8 rounded-3xl backdrop-blur-md shadow-inner">
            <h3 class="text-2xl font-black text-indigo-400 uppercase tracking-tighter mb-4">A Note From the Dev</h3>
            
            <div class="space-y-4 text-sm text-slate-300 leading-relaxed mb-8">
                <p>
                    Hey! Driftaku is built and maintained entirely by a single developer (who got tired of watching anime and wanted to build something out of it instead). 
                </p>
                <p>
                    Running the servers, compiling the daily databases, and hosting the multiplayer lobbies takes a lot of time and coffee. But <strong>I don't want your money.</strong>
                </p>
                <p>
                    If you enjoy the game, there are three completely free ways you can keep Driftaku alive:
                </p>
            </div>

            <ul class="space-y-3 mb-8">
                <li class="flex items-center gap-3 bg-slate-900 border border-white/5 p-3 rounded-xl">
                    <span class="text-xl">📅</span>
                    <span class="text-xs font-bold text-white uppercase tracking-widest">Play the daily challenge once a week</span>
                </li>
                <li class="flex items-center gap-3 bg-slate-900 border border-white/5 p-3 rounded-xl">
                    <span class="text-xl">⚔️</span>
                    <span class="text-xs font-bold text-white uppercase tracking-widest">Trap your friends in a multiplayer lobby</span>
                </li>
                <li class="flex items-center gap-3 bg-slate-900 border border-white/5 p-3 rounded-xl">
                    <span class="text-xl">🛡️</span>
                    <span class="text-xs font-bold text-white uppercase tracking-widest">Whitelist this site on your ad-blocker</span>
                </li>
            </ul>

            <div class="flex gap-4">
                <a href="/contact" class="flex-1 text-center bg-slate-800 hover:bg-slate-700 text-white text-xs font-black uppercase tracking-widest py-3.5 rounded-xl transition-colors border border-white/5">
                    Send Feedback
                </a>
            </div>
        </div>

    </div>
</section>