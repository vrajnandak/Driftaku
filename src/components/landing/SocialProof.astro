---
interface Props {
    players: string;
    modes: string;
}
const { players, modes } = Astro.props;
---
<section class="mt-32 pt-20 pb-20 border-t border-white/5 bg-gradient-to-b from-transparent to-slate-900/50">
    <div class="max-w-4xl mx-auto px-4 text-center">
        
        <h2 class="text-3xl md:text-5xl font-black text-white mb-6 uppercase tracking-tighter">Join the Drift</h2>
        <p class="text-slate-400 text-lg mb-16 leading-relaxed max-w-2xl mx-auto">
            Unlike traditional trivia, Driftaku requires spatial logic and deep industry knowledge. By mapping relationships between thousands of anime titles, voice actors, and studios, we've created a dynamic puzzle that never repeats.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 sm:gap-6 opacity-90">
            <!-- Stat 1 -->
            <div class="text-center">
                <p class="text-5xl md:text-6xl font-black text-white tracking-tighter mb-2">{players}</p>
                <div class="h-1 w-12 bg-indigo-500 mx-auto rounded-full mb-3"></div>
                <p class="text-xs md:text-sm uppercase tracking-[0.2em] text-slate-500 font-bold">Active Drifters</p>
            </div>
            
            <!-- Stat 2 -->
            <div class="text-center">
                <p class="text-5xl md:text-6xl font-black text-white tracking-tighter mb-2">{modes}</p>
                <div class="h-1 w-12 bg-emerald-500 mx-auto rounded-full mb-3"></div>
                <p class="text-xs md:text-sm uppercase tracking-[0.2em] text-slate-500 font-bold">Game Modes</p>
            </div>
            
            <!-- Stat 3 -->
            <div class="text-center">
                <p class="text-5xl md:text-6xl font-black text-white tracking-tighter mb-2">24/7</p>
                <div class="h-1 w-12 bg-cyan-500 mx-auto rounded-full mb-3"></div>
                <p class="text-xs md:text-sm uppercase tracking-[0.2em] text-slate-500 font-bold">New Challenges</p>
            </div>
        </div>
    </div>
</section>