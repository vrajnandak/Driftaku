<section class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center my-20">
    <div>
        <h2 class="text-3xl font-bold text-white mb-6">Master the Drift</h2>
        <p class="text-slate-400 mb-6 leading-relaxed">
            New to Driftaku? It's simple to learn but hard to master. Watch our quick 60-second tutorial to understand how to navigate the web, avoid dead ends, and use voice actor overlaps to your advantage.
        </p>
        <div class="space-y-4 mb-8">
            <div class="flex items-start">
                <div class="mt-1 bg-indigo-500/20 p-1 rounded-full text-indigo-400 mr-3">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-slate-300">Click connected nodes to move through the graph.</span>
            </div>
            <div class="flex items-start">
                <div class="mt-1 bg-indigo-500/20 p-1 rounded-full text-indigo-400 mr-3">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-slate-300">Use Studios and Voice Actors as bridges between series.</span>
            </div>
        </div>
    </div>
    
    <div class="aspect-video bg-slate-900 rounded-3xl border border-white/10 overflow-hidden shadow-2xl relative group">
        <div class="absolute inset-0 flex items-center justify-center">
            <div class="w-20 h-20 bg-indigo-600 rounded-full flex items-center justify-center group-hover:scale-110 transition-transform cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M8 5v14l11-7z" />
                </svg>
            </div>
        </div>
        <div class="absolute bottom-4 left-4 right-4 text-center">
            <p class="text-[10px] uppercase tracking-widest text-slate-500 font-bold">Tutorial Video</p>
        </div>
    </div>
</section>