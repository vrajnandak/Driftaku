---
interface Props {
	type: 'banner' | 'skyscraper' | 'inline';
	class?: string;
}

const { type, class: className = '' } = Astro.props;

// Explicit dimensions to prevent Cumulative Layout Shift (CLS)
const dimensions = {
	banner: "w-full min-h-[90px] max-w-[728px] mx-auto",
	skyscraper: "w-full min-h-[600px] max-w-[300px] mx-auto",
	inline: "w-full min-h-[250px] mx-auto"
};

// Your actual Google AdSense Publisher ID
const AD_CLIENT = "ca-pub-3643916051400406"; 

// The specific Ad Slot IDs
const AD_SLOTS = {
    banner: "3515289899",     // Driftaku - Banner
    skyscraper: "3515289899", // (Using banner ID for now, replace if you make a Skyscraper unit)
    inline: "3515289899"      // (Using banner ID for now, replace if you make an Inline unit)
};
---

<div class={`ad-wrapper overflow-hidden bg-slate-900/20 rounded-xl flex justify-center items-center ${dimensions[type]} ${className}`}>
    
    <!-- The actual AdSense injected element -->
    <ins class="adsbygoogle"
        style="display:block; width:100%; height:100%;"
        data-ad-client={AD_CLIENT}
        data-ad-slot={AD_SLOTS[type]}
        data-ad-format="auto"
        data-full-width-responsive="true">
    </ins>

    <!-- 
        is:inline tells Astro not to bundle this script, 
        ensuring it fires correctly every time this component is rendered 
    -->
    <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
</div>

<style>
    /* 
      Hides the ad wrapper entirely if AdSense doesn't have an ad available 
      to show to the user, preventing blank awkward gaps in your layout.
    */
    ins.adsbygoogle[data-ad-status="unfilled"] {
        display: none !important;
    }
</style>