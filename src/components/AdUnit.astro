---
interface Props {
	type: 'banner' | 'skyscraper' | 'inline';
	class?: string;
}

const { type, class: className } = Astro.props;

const dimensions = {
	banner: "w-full h-24 max-w-[728px]", // Standard leaderboard size constraint
	skyscraper: "w-full h-[600px] max-w-[300px]",
	inline: "w-full h-48"
}
