---
export const prerender = false; // Keep false to allow dynamic search

// --- EDGE CACHING FOR CLOUDFLARE ---
// This tells Cloudflare's CDN to cache this page for 1 hour (3600 seconds)
// and serve stale cache for up to 10 minutes while it updates in the background.
// This gives you pre-rendered static speeds with SSR flexibility.
Astro.response.headers.set(
  'Cache-Control', 
  'public, max-age=60, s-maxage=3600, stale-while-revalidate=600'
);

import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// 1. Get Search Parameters from URL
const searchDate = Astro.url.searchParams.get('date');
const filterType = Astro.url.searchParams.get('type') || 'exact';

// 2. Get today's date in target timezone
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Kolkata',
}).format(new Date());

// 3. Build Dynamic Query with Strict Security
let query = supabase
  .from('daily_challenges')
  .select('play_date, metadata, nodes_data, results')
  .lte('play_date', today) // SECURITY: Never fetch records greater than today!
  .order('play_date', { ascending: false })
  .limit(30);

if (searchDate) {
    if (filterType === 'exact') {
        // SECURITY: If they try to search a future date, force an empty query
        if (searchDate <= today) {
            query = query.eq('play_date', searchDate);
        } else {
            query = query.eq('play_date', '1970-01-01'); // Returns nothing
        }
    } else if (filterType === 'before') {
        // SECURITY: Use the oldest of the searched date and today
        const targetDate = searchDate < today ? searchDate : today;
        query = query.lte('play_date', targetDate);
    }
}

const { data: pastWebs, error } = await query;

const formatPlayDate = (dateString: string) => {
    const [year, month, day] = dateString.split('-').map(Number);
    const date = new Date(Date.UTC(year, month - 1, day));
    return new Intl.DateTimeFormat('en-US', {
        timeZone: 'UTC',
        month: 'short',
        day: 'numeric',
        year: 'numeric',
    }).format(date);
};

const getImageUrl = (nodes: any[], nodeId: number) => 
    nodes.find(n => n.id === nodeId)?.image;

const hasActiveFilter = !!searchDate;
---

<Layout title="Archive | Driftaku Past Webs">
    <main class="max-w-7xl mx-auto px-4 py-12 md:py-16">
        
        <header class="mb-10 text-center md:text-left">
            <h1 class="text-4xl md:text-5xl font-black text-white uppercase tracking-tighter mb-4">The Archive</h1>
            <p class="text-slate-400">Revisit your favorite daily challenges, search past dates, and see who holds the world records.</p>
        </header>

        <!-- SEARCH / FILTER FORM -->
        <form method="GET" action="/archive" class="bg-slate-900 border border-white/10 p-4 md:p-6 rounded-3xl flex flex-col md:flex-row gap-4 mb-12 shadow-2xl relative z-10">
            <div class="flex-1 flex flex-col sm:flex-row gap-4">
                <div class="flex-1 relative">
                    <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-widest mb-1 pl-1">Filter Type</label>
                    <select name="type" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3.5 text-white text-sm focus:outline-none focus:border-indigo-500 appearance-none cursor-pointer">
                        <option value="exact" selected={filterType === 'exact'}>Exact Date (==)</option>
                        <option value="before" selected={filterType === 'before'}>On or Before (&lt=) </option>
                    </select>
                    <!-- Custom Arrow -->
                    <div class="absolute right-4 top-[2.1rem] pointer-events-none text-slate-500">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linjoin="round" stroke-width={2} d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>
                <div class="flex-1">
                    <label class="block text-[10px] uppercase font-bold text-slate-500 tracking-widest mb-1 pl-1">Target Date</label>
                    <!-- Dark mode calendar icon via [color-scheme:dark] -->
                    <input type="date" name="date" max={today} value={searchDate || ''} required class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-indigo-500 [color-scheme:dark]" />
                </div>
            </div>
            
            <div class="flex items-end gap-2 mt-2 md:mt-0">
                {hasActiveFilter && (
                    <a href="/archive" class="w-full md:w-auto bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold uppercase tracking-widest px-6 py-3.5 rounded-xl transition-all text-xs text-center border border-white/5">
                        Clear
                    </a>
                )}
                <button type="submit" class="w-full md:w-auto bg-indigo-600 hover:bg-indigo-500 text-white font-black uppercase tracking-widest px-8 py-3.5 rounded-xl transition-all shadow-lg shadow-indigo-500/20 text-sm">
                    Search
                </button>
            </div>
        </form>

        <!-- NO RESULTS STATE -->
        {pastWebs?.length === 0 && (
            <div class="text-center py-20 bg-slate-900/50 rounded-3xl border border-white/5 border-dashed">
                <svg class="w-16 h-16 text-slate-600 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width={1.5} d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                </svg>
                <h3 class="text-xl font-bold text-white mb-2">No Webs Found</h3>
                <p class="text-slate-400">We couldn't find any challenges matching that date criteria.</p>
            </div>
        )}

        <!-- GRID LAYOUT -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {pastWebs?.map((web) => {
                const nodes = web.nodes_data;
                const startImg = getImageUrl(nodes, web.metadata.start_node);
                const endImg = getImageUrl(nodes, web.metadata.end_node);
                
                // Sort results by time to get the Top 3
                const sortedResults = (web.results || []).slice(0, 3);
                    
                const bestTime = sortedResults.length > 0 ? sortedResults[0].time.toFixed(2) : '--';

                return (
                    <div class="bg-slate-900 border border-white/10 rounded-3xl p-5 hover:border-indigo-500/50 transition-all shadow-xl group flex flex-col h-full relative overflow-hidden">
                        
                        <!-- Top Bar -->
                        <div class="flex justify-between items-start mb-6">
                            <div>
                                <p class="text-[10px] font-black text-indigo-400 uppercase tracking-widest mb-1">{formatPlayDate(web.play_date)}</p>
                                <h3 class="text-lg font-black text-white tracking-tight leading-tight">{web.metadata.title}</h3>
                            </div>
                            <div class="bg-slate-950 border border-white/5 px-2 py-1 rounded-lg text-[10px] font-mono text-emerald-400 font-bold shrink-0 shadow-inner">
                                WR: {bestTime}s
                            </div>
                        </div>
                        
                        <!-- Visual Path Indicator -->
                        <div class="flex items-center justify-between gap-3 mb-6 relative">
                            <!-- Background connecting line -->
                            <div class="absolute left-10 right-10 top-7 h-0.5 bg-gradient-to-r from-slate-700 to-slate-700 z-0 border-t border-dashed border-slate-500"></div>
                            
                            <div class="flex flex-col items-center flex-1 min-w-0 z-10">
                                <div class="w-14 h-14 rounded-full bg-slate-950 border-4 border-white shadow-lg overflow-hidden shrink-0">
                                    {startImg ? <img src={startImg} class="w-full h-full object-cover" /> : <div class="w-full h-full bg-slate-800"></div>}
                                </div>
                                <span class="text-[10px] text-white font-bold truncate w-full text-center mt-2 px-1" title={web.metadata.start_name}>{web.metadata.start_name}</span>
                            </div>
                            
                            <div class="text-slate-500 font-black text-xl z-10 drop-shadow-md">→</div>
                            
                            <div class="flex flex-col items-center flex-1 min-w-0 z-10">
                                <div class="w-14 h-14 rounded-full bg-slate-950 border-4 border-cyan-400 shadow-lg overflow-hidden shrink-0">
                                    {endImg ? <img src={endImg} class="w-full h-full object-cover" /> : <div class="w-full h-full bg-slate-800"></div>}
                                </div>
                                <span class="text-[10px] text-white font-bold truncate w-full text-center mt-2 px-1" title={web.metadata.end_name}>{web.metadata.end_name}</span>
                            </div>
                        </div>

                        <!-- Mini Leaderboard -->
                        <div class="bg-slate-950 rounded-2xl p-4 flex-1 border border-white/5 mb-6">
                            <div class="flex justify-between items-end border-b border-white/10 pb-2 mb-3">
                                <h4 class="text-[9px] uppercase tracking-widest font-black text-slate-500">Top Drifters</h4>
                                <span class="text-[9px] font-bold text-slate-600">{web.results?.length || 0} Solves</span>
                            </div>
                            
                            <div class="space-y-2">
                                {sortedResults.length > 0 ? sortedResults.map((res: any, i: number) => (
                                    <div class="flex justify-between items-center text-xs">
                                        <div class="flex items-center gap-2 min-w-0">
                                            <span class={`font-black ${i === 0 ? 'text-amber-400' : i === 1 ? 'text-slate-300' : 'text-amber-600'}`}>#{i+1}</span>
                                            <span class="font-bold text-white truncate max-w-[100px]">{res.name}</span>
                                        </div>
                                        <span class="font-mono text-emerald-400 font-bold shrink-0">{res.time.toFixed(2)}s</span>
                                    </div>
                                )) : (
                                    <p class="text-[10px] text-slate-500 font-bold uppercase tracking-widest text-center py-2">No times recorded</p>
                                )}
                            </div>
                        </div>

                        <!-- Action Button -->
                        <div class="mt-auto">
                            <div class="flex justify-between text-[9px] font-bold text-slate-500 uppercase tracking-widest mb-3 px-1">
                                <span>Size: {nodes.length} Nodes</span>
                            </div>

                            <a href={`/play/daily/${web.play_date}`} class="block w-full py-4 bg-slate-800 group-hover:bg-indigo-600 text-white font-black uppercase tracking-widest text-center rounded-xl transition-all shadow-md group-hover:shadow-indigo-500/25 active:scale-95 text-xs">
                                Play Now
                            </a>
                        </div>
                    </div>
                );
            })}
        </div>
    </main>
</Layout>

<style>
    /* Ensures dark mode icon for the native date picker calendar icon */
    input[type="date"]::-webkit-calendar-picker-indicator {
        filter: invert(1);
        opacity: 0.6;
        cursor: pointer;
    }
    input[type="date"]::-webkit-calendar-picker-indicator:hover {
        opacity: 1;
    }
</style>