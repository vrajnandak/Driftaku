---
import Layout from '../layouts/Layout.astro';
---

<!-- NEW: Added robots prop to prevent indexing -->
<Layout title="404 - Page Not Found | Driftaku" robots="noindex, follow">
    <div class="min-h-[calc(100vh-4rem)] w-full flex items-center justify-center p-6 relative overflow-hidden">
        
        {/* Background Decorative Elements */}
        <div class="absolute top-1/4 left-1/4 w-72 h-72 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute bottom-1/4 right-1/4 w-96 h-96 bg-rose-600/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 text-center max-w-lg mx-auto">
            {/* 404 Floating Node Graphic */}
            <div class="relative w-32 h-32 mx-auto mb-8 animate-[bounce_4s_ease-in-out_infinite]">
                <div class="absolute inset-0 bg-slate-900 border-4 border-rose-500/50 rounded-full shadow-[0_0_50px_rgba(244,63,94,0.3)] flex items-center justify-center backdrop-blur-md">
                    <span class="text-4xl font-black text-rose-500 tracking-tighter">404</span>
                </div>
                {/* Broken link visual */}
                <div class="absolute top-1/2 -left-12 w-12 h-1 border-t-4 border-dashed border-slate-700"></div>
                <div class="absolute top-1/2 -right-12 w-12 h-1 border-t-4 border-dashed border-slate-700"></div>
            </div>

            <h1 class="text-3xl md:text-5xl font-black text-white uppercase tracking-tighter mb-4">
                Node Disconnected
            </h1>
            
            <p class="text-slate-400 font-bold uppercase tracking-widest text-xs md:text-sm leading-relaxed mb-10">
                You've drifted too far into the void. The path you are looking for does not exist in our database.
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a 
                    href="/" 
                    class="w-full sm:w-auto px-8 py-4 bg-indigo-600 hover:bg-indigo-500 text-white font-black uppercase tracking-widest rounded-xl transition-all shadow-lg shadow-indigo-500/20 active:scale-95 text-xs md:text-sm"
                >
                    Return to Hub
                </a>
                <a 
                    href="/archive" 
                    class="w-full sm:w-auto px-8 py-4 bg-slate-800 hover:bg-slate-700 text-white border border-white/10 font-black uppercase tracking-widest rounded-xl transition-all active:scale-95 text-xs md:text-sm"
                >
                    Play Archives
                </a>
            </div>
        </div>
    </div>
</Layout>