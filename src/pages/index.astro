---
import Layout from '../layouts/Layout.astro';
import GameClient from '../components/GameClient.tsx';
import AdUnit from '../components/AdUnit.astro';
import HowToPlay from '../components/HowToPlay.astro';
import StatsCard from '../components/StatsCard.astro';

// Levels
import levelData from '../game_levels/daily_seed_1.json';

const levelTitle = `Daily Web #${levelData.metadata.level.toString().padStart(3, '0')}`;
---

<Layout title="Driftaku | Daily Anime Connection Puzzle">
	<main class="max-w-6xl mx-auto px-4 py-8">
		
		<AdUnit type="banner" class="mb-8" />

		<div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
			<!-- Main Game Area -->
			<div class="lg:col-span-3">
				<div class="bg-slate-900 rounded-2xl border border-white/10 overflow-hidden shadow-2xl relative">
					
					<!-- Game Header -->
					<div class="p-6 border-b border-white/10 flex flex-col md:flex-row md:items-center justify-between gap-4">
						<div>
							<h1 class="text-xl font-bold text-white">{levelTitle}</h1>
							<p class="text-slate-400 text-sm">
								Connect <span class="text-indigo-400 font-bold">{levelData.metadata.start_name}</span> 
								to <span class="text-emerald-400 font-bold">{levelData.metadata.end_name}</span>
							</p>
						</div>
						<div class="flex items-center gap-4">
							<div class="text-right">
								<p class="text-[10px] uppercase text-slate-500 font-bold">Time</p>
								<p id="timer" class="text-xl font-mono text-white">00:00.0</p>
							</div>
						</div>
					</div>

					<!-- Game Canvas Wrapper -->
					<div class="h-[600px] w-full relative bg-black">
						<GameClient client:only="react" levelData={levelData} />
					</div>
				</div>

				<HowToPlay />
			</div>

			<!-- Sidebar -->
			<aside class="lg:col-span-1 space-y-8">
				<StatsCard players="3,421" avgTime="42 seconds" />
				
				<AdUnit type="skyscraper" />
			</aside>
		</div>
	</main>
</Layout>

<style>
	main {
		min-height: calc(100vh - 64px);
	}
</style>