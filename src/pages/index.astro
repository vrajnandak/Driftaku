---
import Layout from '@/layouts/Layout.astro';
import AdUnit from '../components/AdUnit.astro';
import HowToPlay from '../components/HowToPlay.astro';

// Modular Components
import Hero from '../components/landing/Hero.astro';
import GameModes from '../components/landing/GameModes.astro';
import TutorialSection from '../components/landing/TutorialSection.astro';
import StrategyGuide from '../components/landing/StrategyGuide.astro';
import EngineStats from '../components/landing/EngineStats.astro';
import FAQ from '../components/landing/FAQ.astro';

// NEW: Replaced SocialProof with RoadmapAndSupport
import RoadmapAndSupport from '../components/landing/RoadmapAndSupport.astro';
---

<Layout title="Driftaku | The Ultimate Anime Connection Puzzle Game">
    <!-- Ambient Background Glows -->
    <div class="fixed inset-0 z-0 pointer-events-none overflow-hidden">
        <div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-indigo-600/20 blur-[120px] rounded-full mix-blend-screen"></div>
        <div class="absolute top-[40%] right-[-10%] w-[30%] h-[50%] bg-emerald-600/10 blur-[120px] rounded-full mix-blend-screen"></div>
        <div class="absolute bottom-[-10%] left-[20%] w-[50%] h-[30%] bg-cyan-600/10 blur-[120px] rounded-full mix-blend-screen"></div>
    </div>

    <!-- Main Content (z-10 to sit above glows) -->
	<main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-24 space-y-24 md:space-y-32">
		
		<Hero />

		<GameModes />

        <div class="flex justify-center max-w-5xl mx-auto">
		    <AdUnit type="banner" class="rounded-2xl shadow-2xl" />
        </div>

		<TutorialSection />
		<HowToPlay />

		<StrategyGuide />
        <EngineStats />

		<FAQ />

        <!-- NEW COMPONENT PLACEMENT -->
		<RoadmapAndSupport />

	</main>
</Layout>

<style>
	main {
		min-height: calc(100vh - 64px);
	}
</style>