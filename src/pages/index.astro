---
import Layout from '../layouts/Layout.astro';
import AdUnit from '../components/AdUnit.astro';
import HowToPlay from '../components/HowToPlay.astro';

// New Modular Components
import Hero from '../components/landing/Hero.astro';
import GameModes from '../components/landing/GameModes.astro';
import TutorialSection from '../components/landing/TutorialSection.astro';
import SocialProof from '../components/landing/SocialProof.astro';
---

<Layout title="Driftaku | The Ultimate Anime Connection Puzzle">
	<main class="max-w-6xl mx-auto px-4 py-12">
		
		<Hero />

		<GameModes />

		<AdUnit type="banner" class="my-16" />

		<TutorialSection />

		<HowToPlay />

		<SocialProof players="12,842" modes="3" />

	</main>
</Layout>

<style>
	main {
		min-height: calc(100vh - 64px);
	}
</style>