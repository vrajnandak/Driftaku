---
export const prerender = true; // 100% Static Page. Loads instantly!

import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact Us | Driftaku" description="Report bugs, suggest features, or get in touch with the Driftaku development team.">
    <main class="max-w-6xl mx-auto px-4 py-12 md:py-20 font-sans">
        
        <!-- Header -->
        <header class="text-center mb-16 relative">
            <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-48 h-48 bg-indigo-500/10 blur-[80px] rounded-full -z-10"></div>
            
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-[10px] font-bold uppercase tracking-widest mb-6 shadow-[0_0_15px_rgba(99,102,241,0.2)]">
                Comms Channel
            </span>
            
            <h1 class="text-5xl md:text-6xl font-black text-white uppercase tracking-tighter mb-4">Get in Touch</h1>
            <p class="text-slate-400 max-w-lg mx-auto text-sm md:text-base">
                Found a bug? Have a brilliant idea for a new feature? Or just want to talk about anime? Drop a message below.
            </p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
            
            <!-- LEFT COLUMN: THE FORM -->
            <div class="lg:col-span-7 bg-slate-900 border border-white/10 rounded-3xl p-6 md:p-8 shadow-2xl relative overflow-hidden">
                <div class="absolute -left-20 -top-20 w-64 h-64 bg-indigo-500/10 blur-[80px] rounded-full pointer-events-none"></div>
                
                <h2 class="text-2xl font-black text-white uppercase tracking-tighter mb-6 relative z-10">Send a Transmission</h2>
                
                <!-- SUCCESS STATE (Hidden by default) -->
                <div id="success-state" class="hidden relative z-10 bg-emerald-500/10 border border-emerald-500/20 rounded-2xl p-8 text-center">
                    <div class="w-16 h-16 bg-emerald-500/20 text-emerald-400 rounded-full flex items-center justify-center mx-auto mb-4 border border-emerald-500/30 shadow-[0_0_20px_rgba(16,185,129,0.2)]">
                        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <h3 class="text-2xl font-black text-white uppercase tracking-tight mb-2">Message Received</h3>
                    <p class="text-sm text-slate-400 mb-6">Thanks for reaching out! Your transmission has been successfully logged in the Driftaku database.</p>
                    <a href="/" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white font-bold uppercase tracking-widest px-8 py-3 rounded-xl transition-all shadow-lg text-xs">
                        Return Home
                    </a>
                </div>

                <!-- FORM STATE -->
                <form id="contact-form" class="space-y-6 relative z-10">
                    
                    <!-- ERROR MESSAGE (Hidden by default) -->
                    <div id="error-message" class="hidden bg-rose-500/10 border border-rose-500/20 text-rose-400 p-4 rounded-xl text-sm font-bold flex items-center gap-3">
                        <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                        <span id="error-text">Failed to send.</span>
                    </div>

                    <!-- Honeypot -->
                    <div style="display: none;" aria-hidden="true">
                        <input type="text" name="botcheck" tabindex="-1" autocomplete="off" />
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 pl-1">Your Name</label>
                            <input type="text" name="name" required placeholder="OtakuName123" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-indigo-500 transition-colors" />
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 pl-1">Contact Info</label>
                            <input type="text" name="contact" required placeholder="Email or Discord Tag" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-indigo-500 transition-colors" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 pl-1">Topic</label>
                            <select name="topic" required class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-indigo-500 transition-colors appearance-none cursor-pointer">
                                <option value="Feature Request">💡 Feature Request</option>
                                <option value="Bug Report">🐛 Bug Report</option>
                                <option value="Data Issue">📊 Database / Node Issue</option>
                                <option value="General Feedback">💬 General Feedback</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 pl-1">Where did this happen?</label>
                            <select name="location" class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-indigo-500 transition-colors appearance-none cursor-pointer">
                                <option value="Not Applicable">N/A</option>
                                <option value="Daily Challenge">Daily Challenge</option>
                                <option value="Archive">Archive</option>
                                <option value="Leaderboard">Leaderboard</option>
                                <option value="Vs Friends - Lobby">Vs Friends (Lobby)</option>
                                <option value="Vs Friends - Builder">Vs Friends (Building phase)</option>
                                <option value="Vs Friends - Solve">Vs Friends (Solve Phase)</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 pl-1">Message Details</label>
                        <textarea name="message" required rows="5" minlength="10" maxlength="1000" placeholder="Describe the issue, missing anime connection, or feature idea here..." class="w-full bg-slate-950 border border-white/10 rounded-xl px-4 py-3 text-white text-sm focus:outline-none focus:border-indigo-500 transition-colors custom-scrollbar resize-y"></textarea>
                    </div>

                    <button id="submit-btn" type="submit" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-black uppercase tracking-widest py-4 rounded-xl transition-all shadow-lg shadow-indigo-500/20 active:scale-95 text-sm flex items-center justify-center gap-2">
                        <span>Transmit Message</span>
                        <div id="btn-spinner" class="hidden w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin"></div>
                    </button>
                </form>
            </div>

            <!-- RIGHT COLUMN: INFO & FAQS -->
            <div class="lg:col-span-5 space-y-8">
                <!-- Note to players -->
                <div class="bg-indigo-500/10 border border-indigo-500/20 rounded-3xl p-6 md:p-8 shadow-inner">
                    <h3 class="text-lg font-black text-indigo-400 uppercase tracking-tighter mb-3">Solo Developer</h3>
                    <p class="text-sm text-slate-300 leading-relaxed mb-0">
                        Hey! Driftaku is built and maintained by a solo developer. I read every single message that comes through this channel. If you've found a bug or have an awesome idea to make the game better, let me know!
                    </p>
                </div>

                <!-- Helpful Tips -->
                <div class="bg-slate-900 border border-white/10 rounded-3xl p-6 md:p-8 shadow-xl">
                    <h3 class="text-sm font-black text-white uppercase tracking-widest mb-6 border-b border-white/10 pb-4">What helps me debug faster?</h3>
                    <ul class="space-y-4">
                        <li class="flex gap-4 items-start">
                            <div class="w-8 h-8 rounded-full bg-slate-950 border border-white/10 flex items-center justify-center shrink-0 mt-0.5 text-xs shadow-inner">📱</div>
                            <div>
                                <h4 class="text-white text-xs font-bold uppercase tracking-widest mb-1">Device & Browser</h4>
                                <p class="text-[11px] text-slate-400 leading-relaxed">Let me know if you are playing on an iPhone, Android, or PC, and whether you use Chrome, Safari, etc.</p>
                            </div>
                        </li>
                        <li class="flex gap-4 items-start">
                            <div class="w-8 h-8 rounded-full bg-slate-950 border border-white/10 flex items-center justify-center shrink-0 mt-0.5 text-xs shadow-inner">🔗</div>
                            <div>
                                <h4 class="text-white text-xs font-bold uppercase tracking-widest mb-1">Missing Connections</h4>
                                <p class="text-[11px] text-slate-400 leading-relaxed">If you notice two nodes that <i>should</i> connect but don't, please provide the exact names of both nodes.</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </main>
</Layout>

<!-- CLIENT-SIDE FORM LOGIC -->
<script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    const successState = document.getElementById('success-state');
    const errorMessage = document.getElementById('error-message');
    const errorText = document.getElementById('error-text');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const btnSpinner = document.getElementById('btn-spinner');

    if (form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault(); 

            // UI Loading state
            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-70');
            btnSpinner?.classList.remove('hidden');
            errorMessage?.classList.add('hidden');

            // Convert FormData to a clean JSON object
            const formData = new FormData(form);
            const payload = Object.fromEntries(formData.entries());

            try {
                // Send the data as JSON
                const response = await fetch('/api/submit-contact', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json' // Explicitly set JSON header
                    },
                    body: JSON.stringify(payload) // Stringify payload
                });

                const result = await response.json();

                if (result.success) {
                    form.classList.add('hidden');
                    successState?.classList.remove('hidden');
                } else {
                    if (errorText) errorText.innerText = result.error || "Failed to send message.";
                    errorMessage?.classList.remove('hidden');
                }
            } catch (err) {
                if (errorText) errorText.innerText = "Failed to parse server response. Please try again.";
                errorMessage?.classList.remove('hidden');
            } finally {
                submitBtn.disabled = false;
                submitBtn.classList.remove('opacity-70');
                btnSpinner?.classList.add('hidden');
            }
        });
    }
</script>