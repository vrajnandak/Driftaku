---
export const prerender = false;

// Instruct Cloudflare to cache this page at the edge for 60 seconds.
// This is the magic line that saves your database from reload spam!
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=360, stale-while-revalidate=120');

import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// 1. Get dates in your exact timezone (Asia/Kolkata)
const options = { timeZone: 'Asia/Kolkata', year: 'numeric', month: '2-digit', day: '2-digit' } as const;
const formatter = new Intl.DateTimeFormat('en-CA', options);

const now = new Date();
const today = formatter.format(now);

const yesterdayDate = new Date(now);
yesterdayDate.setDate(yesterdayDate.getDate() - 1);
const yesterday = formatter.format(yesterdayDate);

// 2. Fetch both Today and Yesterday in a SINGLE database call to save latency
const { data: challenges, error } = await supabase
  .from('daily_challenges')
  .select('play_date, results')
  .in('play_date', [today, yesterday]);

// 3. Process the data
let todayResults = [];
let yesterdayResults = [];

if (challenges) {
    const todayData = challenges.find((c: any) => c.play_date === today);
    const yesterdayData = challenges.find((c: any) => c.play_date === yesterday);

    // Parse JSONB and ensure it's sorted by time (lowest first)
    if (todayData?.results) {
        todayResults = todayData.results.sort((a: any, b: any) => a.time - b.time).slice(0, 10);
    }
    if (yesterdayData?.results) {
        yesterdayResults = yesterdayData.results.sort((a: any, b: any) => a.time - b.time).slice(0, 3); // Top 3 only for yesterday
    }
}
---

<Layout title="Hall of Fame | Driftaku Leaderboard" description="Check the fastest times on today's Driftaku puzzle and see yesterday's champions.">
    <main class="max-w-6xl mx-auto px-4 py-12 md:py-16 font-sans">
        
        <!-- Header -->
        <header class="text-center mb-16 relative">
            <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-48 h-48 bg-amber-500/10 blur-[80px] rounded-full -z-10"></div>
            
            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-amber-400 text-[10px] font-bold uppercase tracking-widest mb-6 shadow-[0_0_15px_rgba(245,158,11,0.2)]">
                Hall of Fame
            </span>
            
            <h1 class="text-5xl md:text-6xl font-black text-white uppercase tracking-tighter mb-4">Top Drifters</h1>
            <p class="text-slate-400 max-w-lg mx-auto text-sm md:text-base">
                The fastest minds in the anime multiverse. Rankings update live. Are you fast enough to claim the crown?
            </p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
            
            <!-- LEFT COLUMN: TODAY'S LEADERBOARD -->
            <div class="lg:col-span-8 bg-slate-900 border border-white/10 rounded-3xl p-6 md:p-8 shadow-2xl relative overflow-hidden">
                <div class="absolute -right-20 -top-20 w-64 h-64 bg-indigo-500/10 blur-[80px] rounded-full pointer-events-none"></div>
                
                <div class="flex justify-between items-end mb-8 border-b border-white/10 pb-4">
                    <div>
                        <h2 class="text-2xl font-black text-white uppercase tracking-tighter">Today's Rankings</h2>
                        <p class="text-xs text-indigo-400 font-bold uppercase tracking-widest mt-1">Live Standings</p>
                    </div>
                    <div class="text-right">
                        <span class="text-[9px] uppercase tracking-widest font-bold text-slate-500 block mb-1">Updated</span>
                        <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2 py-1 rounded border border-emerald-500/20">Just Now</span>
                    </div>
                </div>

                {todayResults.length === 0 ? (
                    <div class="text-center py-20 bg-slate-950/50 rounded-2xl border border-white/5 border-dashed">
                        <span class="text-4xl mb-4 block opacity-50">🕸️</span>
                        <h3 class="text-lg font-bold text-white mb-1">The web is empty!</h3>
                        <p class="text-slate-400 text-sm mb-6">No one has solved today's puzzle yet.</p>
                        <a href="/play/daily" class="inline-block bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-black uppercase tracking-widest px-6 py-3 rounded-xl transition-all shadow-lg">
                            Claim First Place
                        </a>
                    </div>
                ) : (
                    <div class="space-y-3">
                        {todayResults.map((s: any, i: number) => {
                            const isFirst = i === 0;
                            const isSecond = i === 1;
                            const isThird = i === 2;
                            
                            return (
                                <div class={`flex items-center justify-between p-4 rounded-2xl transition-all hover:scale-[1.01] ${isFirst ? 'bg-gradient-to-r from-amber-500/20 to-slate-900 border border-amber-500/30 shadow-[0_0_15px_rgba(245,158,11,0.1)]' : isSecond ? 'bg-gradient-to-r from-slate-400/20 to-slate-900 border border-slate-400/30' : isThird ? 'bg-gradient-to-r from-amber-700/20 to-slate-900 border border-amber-700/30' : 'bg-slate-950 border border-white/5 hover:border-white/10'}`}>
                                    <div class="flex items-center gap-4 md:gap-6">
                                        <div class={`w-8 text-center font-black text-xl md:text-2xl ${isFirst ? 'text-amber-400' : isSecond ? 'text-slate-300' : isThird ? 'text-amber-600' : 'text-slate-600'}`}>
                                            #{i + 1}
                                        </div>
                                        <div class="font-bold text-white text-sm md:text-base truncate max-w-[150px] sm:max-w-[300px]">
                                            {s.name}
                                            {isFirst && <span class="ml-2 text-lg inline-block animate-bounce">👑</span>}
                                        </div>
                                    </div>
                                    <div class={`font-mono font-black text-lg md:text-xl ${isFirst ? 'text-amber-400' : 'text-emerald-400'}`}>
                                        {s.time.toFixed(2)}<span class="text-xs ml-0.5 text-slate-500">s</span>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                )}
            </div>

            <!-- RIGHT COLUMN: YESTERDAY'S CHAMPIONS -->
            <div class="lg:col-span-4 space-y-8">
                
                <div class="bg-slate-900 border border-white/10 rounded-3xl p-6 shadow-2xl relative overflow-hidden">
                    <h3 class="text-lg font-black text-white uppercase tracking-tighter mb-1">Yesterday's Podium</h3>
                    <p class="text-[10px] text-slate-400 uppercase tracking-widest mb-6 border-b border-white/10 pb-4">The reigning champions</p>

                    {yesterdayResults.length === 0 ? (
                        <p class="text-sm text-slate-500 italic text-center py-8">No records found for yesterday.</p>
                    ) : (
                        <div class="space-y-4">
                            {yesterdayResults.map((s: any, i: number) => (
                                <div class="flex flex-col gap-1">
                                    <div class="flex justify-between items-end">
                                        <span class="text-sm font-bold text-white truncate max-w-[150px]">
                                            {i === 0 ? '🥇 ' : i === 1 ? '🥈 ' : '🥉 '}{s.name}
                                        </span>
                                        <span class="text-xs font-mono font-bold text-slate-400">{s.time.toFixed(2)}s</span>
                                    </div>
                                    <div class="w-full h-1 bg-slate-950 rounded-full overflow-hidden">
                                        <div class={`h-full ${i === 0 ? 'bg-amber-400 w-full' : i === 1 ? 'bg-slate-300 w-[85%]' : 'bg-amber-700 w-[70%]'}`}></div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}
                </div>

                <!-- Call to Action / Info -->
                <div class="bg-indigo-600/10 border border-indigo-500/20 rounded-3xl p-6 text-center">
                    <h4 class="text-indigo-400 font-bold uppercase tracking-widest text-[10px] mb-2">Think you're faster?</h4>
                    <p class="text-sm text-slate-300 leading-relaxed mb-6">
                        The daily web resets every night at midnight (IST). Practice your paths in "Vs Friends" mode to climb the ranks tomorrow.
                    </p>
                    <a href="/play/daily" class="inline-block w-full bg-indigo-600 hover:bg-indigo-500 text-white font-black uppercase tracking-widest py-3.5 rounded-xl transition-all shadow-lg shadow-indigo-500/20 text-xs">
                        Play Today's Web
                    </a>
                </div>

            </div>

        </div>
    </main>
</Layout>