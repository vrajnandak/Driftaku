---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import ArchiveGameWrapper from '../../../components/game/ArchiveGameWrapper';
import { supabase } from '../../../lib/supabase';

const { date } = Astro.params;

// 1. Validate that the date format strictly matches YYYY-MM-DD
const dateRegex = /^\d{4}-\d{2}-\d{2}$/;
if (!date || !dateRegex.test(date)) {
    return Astro.redirect('/404');
}

// 2. Compute current date in UTC (YYYY-MM-DD) to prevent timezone mismatches
const today = new Date();
const currentUTCStr = `${today.getUTCFullYear()}-${String(today.getUTCMonth() + 1).padStart(2, '0')}-${String(today.getUTCDate()).padStart(2, '0')}`;

// 3. Prevent access if the requested date is in the future
if (date > currentUTCStr) {
    return Astro.redirect('/404');
}

// 4. Safe to proceed — Measure Server-Side DB fetch time
const t0 = performance.now();
const { data: challenge, error } = await supabase
    .from('daily_challenges')
    .select('metadata, nodes_data, intended_path')
    .eq('play_date', date)
    .single();
const t1 = performance.now();
const dbLoadTime = (t1 - t0).toFixed(2);

if (error || !challenge) {
    return Astro.redirect('/404');
}
---

<Layout title={`Driftaku Archive - ${date}`}>
    <div class="h-screen w-screen bg-slate-950 overflow-hidden">
        <ArchiveGameWrapper 
            client:only="react" 
            levelData={{ metadata: challenge.metadata, nodes: challenge.nodes_data }} 
            intendedPath={challenge.intended_path}
            dbLoadTime={dbLoadTime}
            playDate={date}
        />
    </div>
</Layout>