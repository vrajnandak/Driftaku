---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import BountyHuntClient from '../../components/game/BountyHuntClient.tsx';
import { supabase } from '../../lib/supabase';
import GameHeader from '../../components/game/GameHeader.astro';

// Fetch a random drafting pool from Supabase
const { data: pool, error } = await supabase
    .from('draft_pools')
    .select('nodes_data')
    .limit(1)
    .single();

if (error || !pool) {
    return Astro.redirect('/');
}

// Extract nodes and assign a Start and Target (Bot)
const nodes = pool.nodes_data;
const startNode = nodes[0];
const endNode = nodes[Math.floor(nodes.length / 2)];

const levelData = {
    metadata: {
        start_node: startNode.id,
        start_name: startNode.name,
        end_node: endNode.id,
        end_name: endNode.name,
        total_nodes: nodes.length
    },
    nodes: nodes
};
---

<Layout title="Bounty Hunt | Vs Bot | Driftaku" description="Catch the rogue node before it escapes across the anime multiverse!">
    <!-- FIXED: Replaced max-w-7xl with w-full so the canvas breathes -->
    <main class="w-full h-screen mx-auto px-2 py-4 sm:px-4 sm:py-6 flex flex-col font-sans">
        <div class="flex-1 bg-slate-900 rounded-3xl border border-white/10 overflow-hidden shadow-2xl relative flex flex-col min-h-0">
            
            <GameHeader 
                title="Bounty Hunt: Rogue Node"
                startName={startNode.name}
                endName="The Bot (Cyan)"
            />

            <!-- Main Client Area -->
            <div class="flex-1 relative w-full bg-black min-h-0">
                <BountyHuntClient client:only="react" levelData={levelData} />
            </div>
            
        </div>
    </main>
</Layout>