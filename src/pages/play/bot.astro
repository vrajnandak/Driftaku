---
import Layout from '../../layouts/Layout.astro';
import GameClient from '../../components/GameClient.tsx';
import MatchConfig from '../../components/MatchConfig.tsx';
---

<Layout title="Driftaku | Vs. The Bot">
    <main class="max-w-7xl mx-auto p-4 md:p-8 flex flex-col lg:flex-row gap-8">
        
        <!-- Left: Canvas -->
        <div class="flex-1 bg-slate-900 rounded-3xl border border-white/10 p-2 shadow-2xl h-[70vh]">
            <div id="canvas-container" class="w-full h-full bg-black rounded-2xl relative">
                <!-- Bot vs User status overlay goes here -->
                <GameClient client:only="react" levelData={/* Generated Data */} />
            </div>
        </div>

        <!-- Right: Vertical Config Sidebar -->
        <aside class="lg:w-80 space-y-6">
            <MatchConfig client:load />
        </aside>
    </main>
</Layout>