---
import Layout from '../../layouts/Layout.astro';
import GameClient from '../../components/GameClient.tsx';
import GameHeader from '../../components/game/GameHeader.astro';
import AdUnit from '../../components/AdUnit.astro';

// In a real app, you'd fetch the level based on the date. 
// For testing, we use seed_1.
import levelData from '../../game_levels/daily_seed_1.json';

const levelTitle = `Daily Web #${levelData.metadata.level.toString().padStart(3, '0')}`;
---

<Layout title={`${levelTitle} | Driftaku`}>
    <main class="max-w-5xl mx-auto px-4 py-8">
        
        <div class="mb-6 flex justify-between items-end">
            <div>
                <h2 class="text-sm font-bold text-indigo-400 uppercase tracking-widest mb-1">Mode: Daily Challenge</h2>
                <p class="text-xs text-slate-500">Every move is logged for the global leaderboard.</p>
            </div>
            <div class="hidden md:block">
                <AdUnit type="banner" class="!h-16 !w-96" />
            </div>
        </div>

        <div class="bg-slate-900 rounded-3xl border border-white/10 overflow-hidden shadow-2xl relative">
            <GameHeader 
                title={levelTitle}
                startName={levelData.metadata.start_name}
                endName={levelData.metadata.end_name}
            />

            <!-- Game Engine Container -->
            <div class="h-[70vh] min-h-[500px] w-full relative bg-black">
                <GameClient client:only="react" levelData={levelData} />
            </div>
        </div>

        <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="bg-slate-900/50 p-6 rounded-2xl border border-white/5">
                <h3 class="text-white font-bold mb-2">Pro Tip</h3>
                <p class="text-slate-400 text-sm">
                    Stuck? Look for <span class="text-white">Voice Actors</span>. Many actors have hundreds of roles across different studios, making them the perfect "bridges" between disconnected anime series.
                </p>
            </div>
            <div class="bg-slate-900/50 p-6 rounded-2xl border border-white/5">
                <h3 class="text-white font-bold mb-2">Share the Challenge</h3>
                <p class="text-slate-400 text-sm mb-4">Challenge your friends to beat your time on this specific web.</p>
                <button class="bg-indigo-600 text-white text-xs font-bold px-4 py-2 rounded-lg">Copy Challenge Link</button>
            </div>
        </div>

    </main>
</Layout>