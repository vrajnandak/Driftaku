---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import DailyGameWrapper from '../../components/game/DailyGameWrapper.tsx';
import DailyLeaderboard from '../../components/game/DailyLeaderboard.tsx'; // Import new component
import GameHeader from '../../components/game/GameHeader.astro';
import { supabase } from '../../lib/supabase';

const t0 = performance.now();

// 1. Get today's date
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Kolkata',
}).format(new Date());
// 2. Fetch directly from Supabase
const { data: challenge, error } = await supabase
    .from('daily_challenges')
    .select('metadata, nodes_data, intended_path, results')
    .eq('play_date', today)
    .single();

const t1 = performance.now();
const dbLoadTimeMS = (t1-t0).toFixed(2);

if (error || !challenge) {
    // Redirect if no challenge is set up for today
    return Astro.redirect('/404');
}

// 3. Simple mapping
const levelData = {
    metadata: challenge.metadata,
    nodes: challenge.nodes_data
};

const initialResults = challenge.results || [];
---

<Layout title={`Daily Web | Driftaku`}>
    <main class="max-w-5xl mx-auto px-4 py-8">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8 items-start">
            
            <!-- GAME SECTION -->
            <div class="lg:col-span-3 bg-slate-900 rounded-3xl border border-white/10 overflow-hidden shadow-2xl relative">
                <GameHeader 
                    title={challenge.metadata.title || "Daily Challenge"}
                    startName={challenge.metadata.start_name}
                    endName={challenge.metadata.end_name}
                />

                <div class="h-[70vh] min-h-[600px] w-full relative bg-black">
                    <DailyGameWrapper 
                        client:only="react" 
                        levelData={levelData} 
                        intendedPath={challenge.intended_path}
                        dbLoadTime={dbLoadTimeMS}
                    />
                </div>
            </div>

            <!-- LEADERBOARD SECTION -->
            <div class="lg:col-span-1 h-full min-h-[400px]">
                <DailyLeaderboard 
                    client:load 
                    initialResults={initialResults} 
                    playDate={today} 
                />
            </div>
            
        </div>
        <!-- <div class="bg-slate-900 rounded-3xl border border-white/10 overflow-hidden shadow-2xl relative">
            <GameHeader 
                title={challenge.metadata.title}
                startName={challenge.metadata.start_name}
                endName={challenge.metadata.end_name}
            />

            <div class="h-[70vh] min-h-[600px] w-full relative bg-black">
                <DailyGameWrapper 
                    client:only="react" 
                    levelData={levelData} 
                    intendedPath={challenge.intended_path}
                    dbLoadTime = {dbLoadTimeMS}
                />
            </div>
        </div> -->
    </main>
</Layout>