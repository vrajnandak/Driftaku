---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import BuilderClient from '../../../../components/game/BuilderClient.tsx';
import { supabase } from '../../../../lib/supabase';
import { getBase64Image } from '../../../../utils/imageLoader';
import levelData from '../../../../game_levels/daily_seed_1.json'; // Base pool

const { roomId } = Astro.params;

// 1. Fetch Room Config
const { data: room } = await supabase.from('rooms').select('*').eq('id', roomId).single();

if (!room) return Astro.redirect('/play/friends');

// 2. Filter & Process Node Pool based on Room Config
const filteredNodes = levelData.nodes.filter(node => {
    const isAllowedType = room.config.allowedNodes[node.type.toLowerCase()] || 
                          (node.type === 'Anime character' && room.config.allowedNodes.character) ||
                          (node.type === 'Voice Actor' && room.config.allowedNodes.voiceActor);
    return isAllowedType;
});

const processedNodes = await Promise.all(filteredNodes.slice(0, 150).map(async (node) => ({
  ...node,
  image: node.image ? await getBase64Image(node.image) : null
})));

const builderData = {
    config: room.config,
    nodes: processedNodes,
    metadata: {
        start_node: room.config.start_node || processedNodes[0].id,
        end_node: room.config.end_node || processedNodes[10].id
    }
};
---

<Layout title={`Building - Room ${roomId}`}>
    <div class="h-screen w-screen overflow-hidden bg-slate-950">
        <BuilderClient client:only="react" roomId={roomId} builderData={builderData} />
    </div>
</Layout>