---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import BuilderClient from '../../../../components/game/BuilderClient.tsx';

const { roomId } = Astro.params;
if (!roomId) {
  return Astro.redirect('/play/friends');
}
---

<Layout title={`Building - Room ${roomId}`}>
    <div class="h-screen w-screen overflow-hidden bg-slate-950">
        <!-- We use client:only so BuilderClient accesses localStorage securely inside the client's browser -->
        <BuilderClient client:only="react" roomId={roomId} />
    </div>
</Layout>