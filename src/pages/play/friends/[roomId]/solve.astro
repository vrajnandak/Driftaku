---
export const prerender = false;

import Layout from '../../../../layouts/Layout.astro';
import FriendsSolveManager from '../../../../components/game/FriendsSolveManager.tsx';

const { roomId } = Astro.params;

if (!roomId || !/^[A-Z0-9]{6,8}$/.test(roomId)) {
  return Astro.redirect('/play/friends');
}
---

<Layout title={`Solving Web - Room ${roomId}`}>
    <div class="h-screen w-screen overflow-hidden bg-slate-950">
        <FriendsSolveManager client:only="react" roomId={roomId} />
    </div>
</Layout>