---
import Layout from '../layouts/Layout.astro';

// You can store wallpaper URLs in Supabase and fetch them
const wallpapers = [
    { title: "Cyberpunk Anime", url: "/wp1.jpg" },
    { title: "Fantasy Landscape", url: "/wp2.jpg" }
];
---

<Layout title="Anime Wallpapers | High Quality Driftaku Collection">
    <main class="max-w-6xl mx-auto px-4 py-12">
        <h1 class="text-4xl font-black text-white uppercase mb-4">Anime Wallpapers</h1>
        <p class="text-slate-400 mb-8">High-definition anime backgrounds curated for our community.</p>
        
        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
            {wallpapers.map(wp => (
                <div class="bg-slate-900 p-2 rounded-xl border border-white/10">
                    <img src={wp.url} alt={wp.title} class="rounded-lg mb-2" />
                    <p class="text-xs font-bold text-center">{wp.title}</p>
                </div>
            ))}
        </div>
    </main>
</Layout>